+/// The JSON escape at the start of ``rest`` as UTF-8 in ``buf``; a surrogate pair is one character.
+fn unescape(rest: []const u8, buf: *[4]u8) Unescaped {
+    if (rest.len < 2) return .wait;
+    const short: u8 = switch (rest[1]) {
+        '"' => '"',
+        '\\' => '\\',
+        '/' => '/',
+        'b' => 8,
+        'f' => 12,
+        'n' => '\n',
+        'r' => '\r',
+        't' => '\t',
+        'u' => 0,
+        else => return .bad,
+    };
+    if (rest[1] != 'u') {
+        buf[0] = short;
+        return .{ .ok = .{ .used = 2, .len = 1 } };
+    }
+    if (rest.len < 6) return .wait;
+    var code = hex4(rest[2..6]) orelse return .bad;
+    var used: usize = 6;
+    if (code >= 0xdc00 and code < 0xe000) return .bad;
+    if (code >= 0xd800 and code < 0xdc00) {
+        if (rest.len < 12) return .wait;
+        if (rest[6] != '\\' or rest[7] != 'u') return .bad;
+        const low = hex4(rest[8..12]) orelse return .bad;
+        if (low < 0xdc00 or low >= 0xe000) return .bad;
+        code = 0x10000 + ((code - 0xd800) << 10) + (low - 0xdc00);
+        used = 12;
+    }
+    const len = std.unicode.utf8Encode(code, buf) catch return .bad;
+    return .{ .ok = .{ .used = used, .len = len } };
