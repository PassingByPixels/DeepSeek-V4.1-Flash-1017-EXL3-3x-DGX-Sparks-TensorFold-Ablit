+/// A stream whose value went out in part and that the parse then does not take as sent: one call, its arguments
+/// ``sent`` (all of it when ``exact``, else at its start; not JSON: the pieces stopped), the whole reply's content, and the
+/// finish reason stop where the whole reply has tool_calls.
+fn expectGivenUp(a: Allocator, answer: []const u8, sent: []const u8, exact: bool) !void {
+    const whole = wholeMessage(&try bytesAsk(a, answer, .{ .stream = false, .eos = true }));
+    for ([_][]const usize{ &.{1}, &.{5} }) |p| {
+        const r = try Read.of(a, &try bytesAsk(a, answer, .{ .eos = true, .pattern = p }));
+        try std.testing.expectEqualStrings("tool_calls", whole.finish); // the parse takes a call
+        try std.testing.expectEqualStrings("stop", r.finish.?); // no call the client holds is whole
+        try std.testing.expectEqualStrings(whole.content, r.content.items);
+        try std.testing.expectEqual(@as(usize, 1), r.calls.items.len);
+        const got = r.calls.items[0].arguments.items;
+        try std.testing.expect(if (exact) std.mem.eql(u8, sent, got) else std.mem.startsWith(u8, got, sent));
+        try std.testing.expect((try json.parse(a, r.calls.items[0].arguments.items)) == .err);
+    }
+}
