index 0000000..e0ac8c9
--- /dev/null
+++ b/zig/src/families/dsv41/abl.zig
@@ -0,0 +1,82 @@
+//! Run-time abliteration (a local patch, not upstream TensorFold): a rank-1 edit of attn.wo_b's output on chosen
+//! layers, y <- y - lam * mask[row] * (r . y) * r, applied to each rank's fp32 partial before the gather. The edit is
+//! linear, so the sum of the ranks' partials gets the same edit. mask[row] is 1 on an edited row and 0 on a stock row.
+//! TF_ABLIT=<file>: "ABL1", u32 hidden, u32 count, then count records { u32 layer, f32 lam, f32[hidden] r (unit) }.
+const std = @import("std");
+const cuda = @import("cuda");
+const prompt = @import("prompt.zig");
+
+pub const max_layers = 64;
+pub const max_rows = 2048; // model.chunk_rows: a prompt chunk's rows at most (a round's are fewer)
+
+pub const Abl = struct {
+    buf: cuda.DeviceBuffer,
+    dirs: [max_layers]u64 = @splat(0),
+    lam: [max_layers]f32 = @splat(0),
+    t: u64 = 0, // f32 [max_rows]: r . y of each row
+    ts: u64 = 0, // f32 [max_rows]: t times the row's mask
+    mask: u64 = 0, // f32 [max_rows]
+    host: [max_rows]f32 = @splat(1), // the mask's rows on the device (the last upload)
+    want: [max_rows]f32 = @splat(1),
+
+    /// mask[0..n] from `want` (the caller's), uploaded when it differs from the device's.
+    fn push(x: *Abl, e: *const prompt.Engine, n: usize) !void {
+        if (n > max_rows) return error.AblitRows;
+        if (std.mem.eql(f32, x.host[0..n], x.want[0..n])) return;
+        @memcpy(x.host[0..n], x.want[0..n]);
+        try prompt.upload(e, x.mask, &x.host, n * 4);
+    }
+
+    /// A prompt chunk of n rows of one stream: all edited or all stock.
+    pub fn maskChunk(x: *Abl, e: *const prompt.Engine, n: usize, on: bool) !void {
+        @memset(x.want[0..n], if (on) 1 else 0);
+        try x.push(e, n);
+    }
+
+    /// A round's rows: row i edited when its stream's slot is (steer[slot] != 0).
+    pub fn maskRows(x: *Abl, e: *const prompt.Engine, slots: []const i64, steer: []const u8) !void {
+        for (slots, 0..) |s, i| x.want[i] = if (s >= 0 and s < steer.len and steer[@intCast(s)] != 0) 1 else 0;
+        try x.push(e, slots.len);
+    }
+
+    pub fn load(d: anytype, io: std.Io, a: std.mem.Allocator, path: []const u8, hidden: usize) !Abl {
+        const b = try std.Io.Dir.cwd().readFileAllocOptions(io, path, a, .limited(1 << 26), .@"4", null);
+        if (b.len < 12 or !std.mem.eql(u8, b[0..4], "ABL1")) return error.BadAblitFile;
+        const h = std.mem.readInt(u32, b[4..8], .little);
+        const n: usize = std.mem.readInt(u32, b[8..12], .little);
+        if (h != hidden) return error.AblitHiddenMismatch;
+        const rec = 8 + hidden * 4;
+        if (b.len != 12 + n * rec) return error.BadAblitFile;
+        const dir_bytes = n * hidden * 4;
+        var x: Abl = .{ .buf = try cuda.DeviceBuffer.alloc(d, dir_bytes + 3 * max_rows * 4) };
+        errdefer x.buf.free();
+        for (0..n) |i| {
+            const p = b[12 + i * rec ..][0..rec];
+            const l = std.mem.readInt(u32, p[0..4], .little);
+            if (l >= max_layers) return error.BadAblitLayer;
+            x.lam[l] = @bitCast(std.mem.readInt(u32, p[4..8], .little));
+            try x.buf.upload(i * hidden * 4, p[8..]);
+            x.dirs[l] = x.buf.ptr + i * hidden * 4;
+            std.debug.print("ablit: layer {d} lam {d:.3}\n", .{ l, x.lam[l] });
+        }
+        x.t = x.buf.ptr + dir_bytes;
+        x.ts = x.t + max_rows * 4;
+        x.mask = x.ts + max_rows * 4;
+        const ones: [max_rows]f32 = @splat(1);
+        try x.buf.upload(dir_bytes + 2 * max_rows * 4, std.mem.sliceAsBytes(&ones));
+        return x;
+    }
+
+    pub fn deinit(x: *Abl) void {
+        x.buf.free();
+    }
+
+    /// The edit on rows [0, rows) of y fp32 [rows, hidden], when layer li has a direction.
+    pub fn apply(x: *const Abl, e: *const prompt.Engine, y: u64, rows: usize, li: usize) !void {
+        if (li >= max_layers or x.dirs[li] == 0) return;
+        if (rows > max_rows) return error.AblitRows;
+        try e.blas.xv(y, x.dirs[li], x.t, rows, e.c.hidden);
+        try e.blas.dgmmRows(x.t, x.mask, x.ts, rows);
+        try e.blas.rank1(x.dirs[li], x.ts, y, e.c.hidden, rows, -x.lam[li]);
+    }
+};
