+            try std.testing.expectEqual(@as(usize, 1), r.calls.?.len);
+            try std.testing.expectEqualStrings("read", r.calls.?[0].get("function").?.get("name").?.string);
+        }
+        // a second block after it: the longer reading has both calls, the first closer's only the second block's; with
+        // one call a reply each reading has one, and the tie keeps the first closer's (the second block's call)
+        const later = try std.mem.concat(a, u8, &.{ one, "\n", try dsmlWrite(a, v41, "two") });
+        const all = try parse(a, later, tools, null);
