+    defer bs.deinit();
+    for (spellings) |sp| {
+        const values = [_][]const u8{
+            try std.mem.concat(a, u8, &.{ "end: ", sp.close }),
+            try std.mem.concat(a, u8, &.{ "start: ", sp.tag }),
