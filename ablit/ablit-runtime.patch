+test "the streams' share of the engine's time while a prompt fills" {
+    const ms: i96 = std.time.ns_per_ms;
+    const owed = LaneHost.owedAfter;
+    // share 0: one round after each chunk, nothing owed
+    try std.testing.expectEqual(@as(i96, 0), owed(0, 0, true, 1000 * ms));
+    // half the time: a 1,000 ms chunk is followed by 1,000 ms of rounds, then the next chunk is due
+    var due = owed(0, 50, true, 1000 * ms);
+    try std.testing.expectEqual(1000 * ms, due);
+    due = owed(due, 50, false, 300 * ms);
+    try std.testing.expectEqual(700 * ms, due);
+    due = owed(due, 50, false, 800 * ms);
+    try std.testing.expectEqual(@as(i96, 0), due);
+    // a quarter and three quarters
+    try std.testing.expectEqual(300 * ms, owed(0, 25, true, 900 * ms));
+    try std.testing.expectEqual(3000 * ms, owed(0, 75, true, 1000 * ms));
+    // a new prompt's first chunk runs while rounds are owed: its share is added
+    try std.testing.expectEqual(700 * ms, owed(200 * ms, 50, true, 500 * ms));
+}
