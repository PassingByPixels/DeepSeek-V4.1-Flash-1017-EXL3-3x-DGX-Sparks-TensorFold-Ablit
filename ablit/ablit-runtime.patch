+    pub fn rank1(b: *const Blas, r: u64, t: u64, y: u64, k: usize, rows: usize, alpha: f32) Error!void {
+        const one: f32 = 1;
+        try b.check(b.api.cublasSgemm_v2(b.handle, .n, .n, @intCast(k), @intCast(rows), 1, &alpha, r, @intCast(k), t, 1, &one, y, @intCast(k)));
+    }
 };
