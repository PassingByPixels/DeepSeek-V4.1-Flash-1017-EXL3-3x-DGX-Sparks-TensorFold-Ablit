+        try std.testing.expectEqualStrings("two", try argsOf(a, all.calls.?[1]));
+        try std.testing.expectEqualStrings("", all.content);
+        const capped = try parse(a, later, tools, 1);
+        try std.testing.expectEqual(@as(usize, 1), capped.calls.?.len);
+        try std.testing.expectEqualStrings("two", try argsOf(a, capped.calls.?[0]));
+    }
+}
