+            try std.testing.expectEqualStrings(value, try argsOf(a, r.calls.?[0]));
+            try std.testing.expectEqualStrings("", r.content);
+        }
+        try std.testing.expect((try parse(a, one, tools, 0)).calls == null);
+        // a call in another form inside the value, after the closer: one call each way, and the tie keeps the call the
+        // first closer's reading gives
+        const tie = try dsmlWrite(a, v41, try std.mem.concat(a, u8, &.{ "x", close, "\n", q, "\n" }));
+        for ([_]?usize{ null, 1 }) |limit| {
