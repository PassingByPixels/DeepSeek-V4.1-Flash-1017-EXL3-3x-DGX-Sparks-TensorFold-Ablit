+/// The longest run of keep-alive pings between two other events of `seen`.
+fn longestPingRun(seen: *const Seen) usize {
+    var run: usize = 0;
+    var best: usize = 0;
+    for (seen.events.items) |e| {
+        if (std.mem.eql(u8, e, "{\"ping\":true}")) {
+            run += 1;
+            best = @max(best, run);
+        } else run = 0;
+    }
+    return best;
+}
