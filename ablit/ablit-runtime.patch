+    const responses = try std.mem.concat(a, u8, &.{ "\"input\":\"x\",\"stream\":true,\"tools\":[{\"type\":\"function\",\"name\":\"write\",\"parameters\":", schema, "}]}" });
+    for ([_][]const usize{ &.{1}, &.{3}, &.{answer.len} }) |p| {
