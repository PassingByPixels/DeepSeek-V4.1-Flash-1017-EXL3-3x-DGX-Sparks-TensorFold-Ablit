+fn jsonReply(comptime value: []const u8) []const u8 {
+    return "Calling." ++ b_open ++ "<" ++ BD ++ " invoke name=\"TodoWrite\">\n<" ++ BD ++ " parameter name=\"todos\" string=\"false\">" ++ value ++
+        "</" ++ BD ++ " parameter>\n</" ++ BD ++ " invoke>\n" ++ b_close;
+}
+
+const json_values = [_][]const u8{
+    "{\"op\":\"set\",\"text\":\"hello\"}",
+    "[{\"op\":\"set\",\"text\":\"line one\\nline \\\"two\\\"\"},{\"op\":\"del\",\"id\":3}]",
+    "{\"a\":{\"b\":{\"c\":[1,[2,{\"d\":null}]]}}}",
+    "{\"e\":\"\\n \\\" \\\\ \\/ \\u00e9 \\ud83d\\ude00 \\t\"}",
+    "{\"\u{e9}\u{6d77}\u{1f30a}\":\"\u{e9}\u{6d77}\u{1f30a}\",\"k\":[\"\u{1f469}\u{200d}\u{1f4bb}\"]}",
+    "[0,-1,1.5,1e3,1E-2]",
+    "[true,false,null]",
+    "{}",
+    "[]",
+    "\n  { \"a\" : [ 1 , 2 ] ,\n \"b\" : { } , \"c\" :\t\"x\" }\n",
+    "{\"t\":\"a </ b </" ++ BD ++ " par c </" ++ BD ++ "\"}",
+    "{\"k\":[{},[],\"\"],\"n\":{\"m\":[]}}",
+    "[{\"op\":\"set\",\"text\":\"x\"}]",
+    "\n[\n  {\"op\": \"insert\", \"at\": 2, \"text\": \"\\u0041\\u00e9\"}\n]",
+};
