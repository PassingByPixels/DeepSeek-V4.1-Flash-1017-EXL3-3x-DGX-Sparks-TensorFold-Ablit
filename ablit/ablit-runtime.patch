+/// The argument pieces of call 0 that ``tool_stream.Streamer.feedDsml`` sends for growing prefixes of ``answer``, ``step``
+/// bytes apart; ``before`` gets the joined pieces sent while ``mark`` (when given) is not yet whole in the prefix.
+fn feedPieces(a: Allocator, answer: []const u8, step: usize, mark: ?[]const u8, before: *std.ArrayList(u8), strings: bool) ![]const []const u8 {
+    const tools = (try json.parse(a, tools_json)).ok.array;
+    var s = try @import("tool_stream.zig").Streamer.init(a, tools);
+    s.dsml.json_live = !strings; // TENSORFOLD_TOOL_STREAM=strings
+    var pieces: std.ArrayList([]const u8) = .empty;
+    var out: std.ArrayList(json.Value) = .empty;
+    var n: usize = 0;
+    while (n < answer.len) {
+        n = @min(n + step, answer.len);
+        out.clearRetainingCapacity();
+        try s.feedDsml(answer[0..n], &out);
+        const whole_mark = if (mark) |m| std.mem.indexOf(u8, answer[0..n], m) != null else false;
+        for (out.items) |d| for (d.get("tool_calls").?.array) |one| {
+            if (one.get("id") != null) continue;
+            const piece = one.get("function").?.strField("arguments").?;
+            try pieces.append(a, piece);
+            if (!whole_mark) try before.appendSlice(a, piece);
+        };
+    }
+    return pieces.items;
+}
