+test "a string=\"false\" object or array value streams at every byte, its pieces joined to the parse's arguments" {
+    var arena: std.heap.ArenaAllocator = .init(std.testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    inline for (json_values) |v| {
+        const answer = comptime jsonReply(v);
+        const whole = wholeMessage(&try bytesAsk(a, answer, .{ .stream = false, .eos = true }));
+        try std.testing.expectEqual(@as(usize, 1), whole.calls.len);
+        const args = whole.calls[0].get("function").?.strField("arguments").?;
+        try std.testing.expect(std.mem.startsWith(u8, args, "{\"todos\":") and (args[9] == '{' or args[9] == '['));
+        for ([_][]const usize{ &.{1}, &.{ 3, 1, 4, 1, 5, 2 } }) |p| {
+            const r = try Read.of(a, &try bytesAsk(a, answer, .{ .eos = true, .pattern = p }));
+            try std.testing.expectEqualStrings(whole.finish, r.finish.?);
+            try std.testing.expectEqualStrings(whole.content, r.content.items);
+            try std.testing.expectEqual(@as(usize, 1), r.calls.items.len);
+            try std.testing.expectEqualStrings(args, r.calls.items[0].arguments.items);
+            // the key, then the value as it decodes, then the call's brace
+            if (args.len > 14) try std.testing.expect(r.calls.items[0].pieces >= 4);
+        }
+    }
+}
